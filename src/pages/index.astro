---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../data/services';
import { advisers, telHref } from '../data/advisers';
import GuideCard from '../components/guides/GuideCard.astro';
import { tools, toolUrl } from '../data/tools';
import { getGuides } from '../lib/guides';

const latestGuides = (await getGuides()).slice(0, 3);
import { companyProfile } from '../data/reviews';
import FestiveOverlay from '../components/FestiveOverlay.astro';

// The four core actions across the bottom of the header
const actions = [
  { title: 'Talk to an adviser', text: 'Free, no-pressure advice from a Wellington mortgage adviser.', href: '/contact/', cta: 'Get in touch' },
  { title: 'How much can I borrow?', text: 'Your rough borrowing power, deposit and repayments in under a minute.', href: '/calculators/how-much-can-i-borrow/', cta: 'Use the calculator' },
  { title: 'Ready to buy your first home?', text: 'Six quick questions to see where you stand and what’s in the way.', href: '/check/ready-to-buy/', cta: 'Take the 60-second check' },
  { title: 'Could you be paying less?', text: 'See whether switching lenders or refixing could save you money.', href: '/calculators/refinance-savings/', cta: 'Check your mortgage' },
];
---

<Base>
  <!-- Hero: headline, proof, then the four core actions -->
  <section class="hero">
    <svg class="mark" viewBox="0 0 115 94" aria-hidden="true">
      <path d="M114.15 71.28c0-11.88-9.63-21.52-21.52-21.52s-21.52 9.63-21.52 21.52 9.63 21.52 21.52 21.52 21.52-9.63 21.52-21.52" />
      <path d="M106.6 4.02c.85-1.22.56-2.2-.66-2.2H73.47c-1.22 0-2.9.99-3.75 2.2L53.25 27.54c-1.04 1.39-2.65 3.2-5.46 2.32-3.39-1.06-3-7.61-3.92-12.18-.47-2.34-2.09-6.4-3.41-8.22C30.33-4.8 7.08-1.74 1.33 14.81c-5.44 14.82 6.53 30.43 22.25 29.35 7.23-.49 13.62-5.33 16.76-2.39.63.59 1.43 2.32.2 3.91L9.91 89.43c-.85 1.22-.56 2.2.66 2.2h32.47c1.22 0 2.9-.99 3.75-2.2L106.6 4.02Z" />
    </svg>
    <FestiveOverlay />

    <div class="wrap hero-top">
      <h1 class="rise" style="--d:0ms">A better way forward starts with <span class="accent">YourSide.</span></h1>
      <div class="hero-side rise" style="--d:120ms">
        <p class="lede">
          Buying a home, investing in property or securing business finance can feel overwhelming. We make it easier
          to understand your options and move towards what matters to you.
        </p>
        <div class="proof">
          {companyProfile && (
            <a class="rating" href={companyProfile.url} target="_blank" rel="noopener">
              <strong>{companyProfile.rating.toFixed(1)}</strong>
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span>from {companyProfile.count} Google reviews</span>
            </a>
          )}
          <ul class="awards" aria-label="Awards">
            <li><img src="/awards/moneyhub-2026.svg" alt="MoneyHub 2026 Favourite Nationwide Mortgage Adviser, Editor’s Choice" width="72" height="72" /></li>
            <li><img src="/awards/moneyhub-2025.svg" alt="MoneyHub 2025 Favourite Nationwide Mortgage Adviser, Editor’s Choice" width="72" height="72" /></li>
            <li class="wreath"><img src="/awards/loan-market-2022.png" alt="Loan Market Awards 2022 Winner, #1 International Top 20 Businesses" width="72" height="72" /></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="wrap">
      <nav class="core rise" style="--d:240ms" aria-label="Get started">
        <ul>
          {actions.map((a) => (
            <li>
              <a href={a.href}>
                <span class="core-title">{a.title}</span>
                <span class="core-text">{a.text}</span>
                <span class="core-cta">{a.cta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Services: an index, not a card grid -->
  <section id="services" class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>How we help</h2>
        <p>From your first home to your fifth property, we find lending that fits your life, then stay with you to settlement and beyond.</p>
        <p><a class="text-link" href="/contact/">Not sure where to start? Talk to us</a></p>
      </div>
      <ol class="index">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`}>
              <span class="index-title">{s.title}</span>
              <span class="index-text">{s.summary}</span>
              <svg class="index-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why YourSide: one strong statement, four plain points -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="statement">
        <p class="big-quote">Not every bank looks at things the same way. What doesn’t work for one lender might be exactly right for another.</p>
        <img class="corner" src="/brand/badge-in-your-corner-badge.png" alt="" width="140" height="140" />
      </div>
      <div class="points">
        <div>
          <h3>We start by listening</h3>
          <p>Good mortgage advice starts with understanding where you are now, where you’re heading and what might stand in the way.</p>
        </div>
        <div>
          <h3>We work for you</h3>
          <p>We compare lenders to find a solution that fits your circumstances, and present your application in the best possible light.</p>
        </div>
        <div>
          <h3>We get wins where others can’t</h3>
          <p>Self-employed, low deposit or been turned down before? Different lenders see things differently. Talk to us.</p>
        </div>
        <div>
          <h3>Local to Wellington</h3>
          <p>We know the Wellington market and we’re happy to meet in person, by phone or online, whichever suits you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Calculators -->
  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <div>
          <h2>Calculators</h2>
          <p class="sub">Rough numbers in under a minute. No sign-up and no credit check.</p>
        </div>
        <a class="text-link" href="/calculators/">See all calculators</a>
      </div>
      <ul class="tools">
        {tools.map((t) => (
          <li><a href={toolUrl(t.slug)}><span class="tool-q">{t.title}</span><span class="tool-name">{t.name}</span></a></li>
        ))}
        <li><a href="/interest-rates/"><span class="tool-q">What are banks charging?</span><span class="tool-name">Interest rates</span></a></li>
      </ul>
    </div>
  </section>

  <!-- Team: portraits, not cards -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="row-head">
        <h2>The team</h2>
        <a class="text-link" href="/team/">Meet everyone</a>
      </div>
      <ul class="people">
        {advisers.map((a) => (
          <li>
            <a href={`/team/${a.slug}/`}>
              <span class="portrait">
                {a.photo ? <img src={a.photo} alt="" width="480" height="480" loading="lazy" /> : <span class="letter" aria-hidden="true">{a.name[0]}</span>}
              </span>
              <span class="who">{a.fullName}</span>
              <span class="what">{a.role}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Guides -->
  {latestGuides.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="row-head">
          <h2>Guides</h2>
          <a class="text-link" href="/guides/">All guides</a>
        </div>
        <div class="guides">
          {latestGuides.map((g) => <GuideCard guide={g} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact" class="section section--tint">
    <div class="wrap contact">
      <div>
        <h2>Talk to us</h2>
        <p class="intro">Tell us a little about what you’re planning and the right adviser will be in touch, usually within one working day.</p>
        <p>Prefer to pick up the phone? Call an adviser directly.</p>
        <ul class="phones">
          {advisers.filter((a) => a.phone).map((a) => (
            <li><a href={`/team/${a.slug}/`}>{a.fullName}</a><a class="tel" href={telHref(a.phone!)}>{a.phone}</a></li>
          ))}
        </ul>
      </div>
      <ContactForm source="Home page" id="home-form" />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  /* Purple top, paper below: the action panel sits across the join */
  .hero { position: relative; overflow: hidden; background: linear-gradient(var(--purple) 0 calc(100% - 7rem), var(--white) calc(100% - 7rem)); color: #fff; padding-top: clamp(3.5rem, 8vw, 6.5rem); }
  .mark { position: absolute; top: -8%; right: -6%; width: min(52vw, 640px); fill: #452a6c; pointer-events: none; transform-origin: 60% 50%; animation: sway 18s ease-in-out infinite alternate; }

  .hero-top { position: relative; display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: end; }
  .hero h1 { color: #fff; font-size: clamp(2.8rem, 6.6vw, 5.4rem); line-height: 1; max-width: 11ch; margin: 0; }
  .accent { color: var(--uv-light); }
  .lede { font-size: 1.12rem; line-height: 1.65; color: rgb(255 255 255 / 84%); margin: 0; max-width: 32rem; }
  .proof { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 18%); }
  .rating { display: flex; align-items: baseline; gap: 0.5rem; color: #fff; text-decoration: none; font-size: 0.95rem; }
  .rating strong { font: 500 1.6rem/1 var(--font-title); }
  .rating .stars { color: #f5c04a; letter-spacing: 0.08em; }
  .awards { list-style: none; padding: 0; margin: 0; display: flex; align-items: center; gap: 0.9rem; }
  .awards img { width: 72px; height: 72px; object-fit: contain; }
  .awards .wreath img { width: 82px; height: 82px; margin-block: -5px; }

  /* Core actions: one panel, divided by hairlines */
  .core { position: relative; margin-top: clamp(3rem, 6vw, 4.5rem); }
  .core ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: var(--radius-sm); overflow: hidden; outline: 1px solid var(--line); }
  .core li + li { border-left: 1px solid var(--line); }
  .core a { display: flex; flex-direction: column; height: 100%; min-height: 230px; padding: 1.75rem 1.5rem 1.5rem; text-decoration: none; color: var(--slate); transition: background 0.2s, color 0.2s; }
  .core-title { font: 500 clamp(1.3rem, 1.9vw, 1.6rem)/1.15 var(--font-title); letter-spacing: -0.02em; color: var(--purple); }
  .core-text { margin-top: 0.75rem; font-size: 0.95rem; color: var(--slate-muted); }
  .core-cta { margin-top: auto; padding-top: 1.25rem; font-weight: 500; color: var(--purple); text-decoration: underline; text-decoration-color: var(--ultraviolet); text-decoration-thickness: 1.5px; text-underline-offset: 5px; }
  .core li:first-child a { background: var(--ultraviolet); }
  .core li:first-child .core-title, .core li:first-child .core-cta { color: #fff; }
  .core li:first-child .core-text { color: rgb(255 255 255 / 85%); }
  .core li:first-child .core-cta { text-decoration-color: #fff; }
  .core a:hover { background: var(--paper); }
  .core a:hover .core-title { color: var(--ultraviolet); }
  .core li:first-child a:hover { background: var(--purple); }
  .core li:first-child a:hover .core-title { color: #fff; }

  @keyframes sway { from { transform: rotate(-2deg); } to { transform: rotate(2deg) translateY(12px); } }
  .rise { animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  @media (prefers-reduced-motion: reduce) { .mark, .rise { animation: none; } }

  @media (max-width: 960px) {
    .hero-top { grid-template-columns: 1fr; align-items: start; }
    .core ul { grid-template-columns: 1fr 1fr; }
    .core li:nth-child(3) { border-left: 0; }
    .core li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .mark { width: 80vw; top: -4%; right: -30%; }
  }
  @media (max-width: 560px) {
    .hero { background: linear-gradient(var(--purple) 0 calc(100% - 4rem), var(--white) calc(100% - 4rem)); }
    .core ul { grid-template-columns: 1fr; }
    .core li + li { border-left: 0; border-top: 1px solid var(--line); }
    .core a { min-height: 0; }
    .core-cta { padding-top: 1rem; }
  }

  /* ---------- Services index ---------- */
  .split { display: grid; grid-template-columns: 0.8fr 1.4fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .split-head { position: sticky; top: 110px; }
  .split-head p { color: var(--slate-muted); max-width: 26rem; }
  .index { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .index li { border-top: 1px solid var(--line); }
  .index a {
    display: grid; grid-template-columns: minmax(0, 15rem) 1fr auto; gap: 0.5rem 2rem; align-items: baseline;
    padding: 1.6rem 0.25rem; text-decoration: none; color: var(--slate); transition: padding 0.25s, background 0.25s;
  }
  .index-title { font: 500 clamp(1.35rem, 2.2vw, 1.75rem)/1.15 var(--font-title); letter-spacing: -0.02em; color: var(--purple); }
  .index-text { color: var(--slate-muted); }
  .index-arrow { color: var(--purple); align-self: center; transition: transform 0.25s, color 0.25s; }
  .index a:hover { padding-left: 1rem; background: var(--paper); }
  .index a:hover .index-title, .index a:hover .index-arrow { color: var(--ultraviolet); }
  .index a:hover .index-arrow { transform: translateX(4px); }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .split-head { position: static; }
    .index a { grid-template-columns: 1fr auto; }
    .index-text { grid-column: 1; }
    .index-arrow { grid-row: 1 / span 2; grid-column: 2; }
  }

  /* ---------- Statement + points ---------- */
  .statement { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .big-quote { font: 500 clamp(1.8rem, 3.6vw, 3rem)/1.15 var(--font-title); letter-spacing: -0.03em; color: var(--purple); max-width: 24ch; margin: 0; }
  .corner { width: 140px; flex: none; }
  .points { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .points > div { border-top: 2px solid var(--purple); padding-top: 1.25rem; }
  .points h3 { font-size: 1.1rem; }
  .points p { color: var(--slate-muted); margin: 0; font-size: 0.98rem; }
  @media (max-width: 900px) { .points { grid-template-columns: 1fr 1fr; } .corner { width: 96px; } }
  @media (max-width: 520px) { .points { grid-template-columns: 1fr; } .statement { flex-direction: column-reverse; } }

  /* ---------- Shared row heading ---------- */
  .row-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .row-head h2 { margin: 0; }
  .sub { color: var(--slate-muted); margin: 0.5rem 0 0; }

  /* ---------- Calculators ---------- */
  .tools { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .tools li { border-bottom: 1px solid var(--line); }
  .tools li:not(:nth-child(3n)) { border-right: 1px solid var(--line); }
  .tools a { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; height: 100%; min-height: 150px; padding: 1.5rem; text-decoration: none; transition: background 0.2s; }
  .tool-q { font: 500 1.3rem/1.2 var(--font-title); letter-spacing: -0.02em; color: var(--purple); }
  .tool-name { font-size: 0.9rem; color: var(--slate-muted); }
  .tools a:hover { background: var(--paper); }
  .tools a:hover .tool-q { color: var(--ultraviolet); }
  @media (max-width: 860px) {
    .tools { grid-template-columns: 1fr 1fr; }
    .tools li:not(:nth-child(3n)) { border-right: 0; }
    .tools li:nth-child(odd) { border-right: 1px solid var(--line); }
  }
  @media (max-width: 520px) { .tools { grid-template-columns: 1fr; } .tools li:nth-child(odd) { border-right: 0; } .tools a { min-height: 0; } }

  /* ---------- Team portraits ---------- */
  .people { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .people a { display: grid; gap: 0.15rem; text-decoration: none; }
  .portrait { display: block; aspect-ratio: 4 / 5; background: var(--purple); border-radius: var(--radius-sm); overflow: hidden; position: relative; margin-bottom: 0.85rem; }
  .portrait img { position: absolute; bottom: 0; left: 50%; width: 112%; max-width: none; transform: translateX(-50%); transition: transform 0.4s; }
  .letter { position: absolute; inset: 0; display: grid; place-items: center; font: 500 5rem/1 var(--font-title); color: var(--uv-light); }
  .people a:hover .portrait img { transform: translateX(-50%) scale(1.03); }
  .who { font-weight: 600; color: var(--purple); font-size: 1.05rem; }
  .what { color: var(--slate-muted); font-size: 0.92rem; }
  .people a:hover .who { color: var(--ultraviolet); }
  @media (max-width: 860px) { .people { grid-template-columns: 1fr 1fr; } }

  /* ---------- Guides ---------- */
  .guides { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }

  /* ---------- Contact ---------- */
  .contact { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .phones { list-style: none; padding: 0; margin: 1rem 0 0; border-top: 1px solid var(--line); max-width: 26rem; }
  .phones li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  .phones a { color: var(--purple); text-decoration: none; font-weight: 500; }
  .phones .tel { color: var(--slate); font-variant-numeric: tabular-nums; }
  .phones a:hover { color: var(--ultraviolet); }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>
