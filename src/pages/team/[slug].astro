---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import { advisers, telHref, type Adviser } from '../../data/advisers';

export function getStaticPaths() {
  return advisers.map((adviser) => ({ params: { slug: adviser.slug }, props: { adviser } }));
}

const { adviser } = Astro.props as { adviser: Adviser };
const others = advisers.filter((a) => a.slug !== adviser.slug);
// While developing, show where missing details will go so they're easy to spot
const showGaps = import.meta.env.DEV;
---

<Base
  title={`${adviser.fullName}, ${adviser.role}`}
  description={`Talk to ${adviser.fullName}, a YourSide mortgage adviser in Wellington${adviser.fspNumber ? ` (FSP${adviser.fspNumber})` : ''}. Free, no-obligation home loan advice.`}
>
  <section class="profile-hero dark">
    <div class="wrap hero-grid">
      <div class="id">
        {adviser.photo
          ? <img class="avatar" src={adviser.photo} alt={`Photo of ${adviser.fullName}`} width="220" height="220" />
          : <span class="avatar initial" aria-hidden="true">{adviser.name[0]}</span>}
        <ul class="details">
          <li class="title">{adviser.role}{adviser.fspNumber && <span> · FSP{adviser.fspNumber}</span>}</li>
          {adviser.phone && (
            <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" /></svg><a href={telHref(adviser.phone)}>{adviser.phone}</a></li>
          )}
          {adviser.email
            ? <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 5h18v14H3zm1.8 1.8v.4l7.2 5.3 7.2-5.3v-.4zm14.4 2.6l-7.2 5.2-7.2-5.2v7.8h14.4z" /></svg><a href={`mailto:${adviser.email}`}>{adviser.email}</a></li>
            : showGaps && <li class="gap">Email to come</li>}
          {adviser.disclosureUrl
            ? <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6 2h9l5 5v15H6zm8 1.5V8h4.5zM9 12h8v1.5H9zm0 3h8v1.5H9z" /></svg><a href={adviser.disclosureUrl} target="_blank" rel="noopener">Disclosure statement</a></li>
            : showGaps && <li class="gap">Disclosure statement to come</li>}
        </ul>
      </div>
      <div>
        <span class="eyebrow">Meet the team</span>
        <h1>{adviser.fullName}</h1>
        <p class="role">{adviser.role}</p>
        <ul class="tags">{adviser.specialties.map((sp) => <li>{sp}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div>
        <h2>About {adviser.name}</h2>
        {adviser.bio.map((p) => <p>{p}</p>)}

        <p class="others">
          Also on the team:{' '}
          {others.map((a, i) => <>{i > 0 && ', '}<a href={`/team/${a.slug}/`}>{a.name}</a></>)}
        </p>
      </div>

      <ContactForm adviser={adviser.slug} source={`Adviser page: ${adviser.name}`} heading={`Talk to ${adviser.name}`} />
    </div>
  </section>

  <GoogleReviews adviser={adviser.slug} name={adviser.name} />
</Base>

<style>
  .profile-hero { padding-block: clamp(3rem, 7vw, 4.5rem); background: var(--purple) url('/brand/pattern-2.jpg') center / cover; }
  .hero-grid { display: flex; align-items: flex-start; gap: clamp(1.5rem, 4vw, 3rem); flex-wrap: wrap; }
  .hero-grid > div:last-child { padding-top: 2.5rem; flex: 1; min-width: 260px; }
  .id { display: grid; justify-items: center; gap: 1.25rem; width: 260px; }
  .details { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; justify-items: center; text-align: center; font-size: 0.95rem; }
  .details li { display: flex; align-items: center; gap: 0.5rem; }
  .details svg { color: var(--uv-light); flex: none; }
  .details a { color: #fff !important; text-decoration: none; font-weight: 600; }
  .details a:hover { text-decoration: underline; }
  .details .title { font-weight: 600; color: var(--uv-light); }
  .details .title span { color: rgb(255 255 255 / 80%); font-weight: 500; }
  .gap { border: 1px dashed rgb(255 255 255 / 40%); border-radius: 6px; padding: 0.2rem 0.6rem; font-size: 0.8rem; color: rgb(255 255 255 / 65%); }
  @media (max-width: 600px) { .hero-grid > div:last-child { padding-top: 0; text-align: center; } .hero-grid { justify-content: center; } .id { width: 100%; } .tags { justify-content: center; } }
  .avatar { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid var(--ultraviolet); }
  .initial { display: grid; place-items: center; background: var(--ultraviolet); color: #fff; font: 600 4.5rem/1 var(--font-title); }
  h1 { margin-bottom: 0.1em; }
  .role { font-size: 1.2rem; font-weight: 500; opacity: 0.9; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags li { background: rgb(255 255 255 / 12%); font-size: 0.85rem; font-weight: 600; padding: 0.35rem 0.8rem; border-radius: 999px; }

  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .others { margin-top: 2rem; color: var(--slate-muted); }
</style>
