---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { advisers, type Adviser } from '../../data/advisers';

export function getStaticPaths() {
  return advisers.map((adviser) => ({ params: { slug: adviser.slug }, props: { adviser } }));
}

const { adviser } = Astro.props as { adviser: Adviser };
const others = advisers.filter((a) => a.slug !== adviser.slug);
---

<Base
  title={`${adviser.name}, ${adviser.role}`}
  description={`Talk to ${adviser.name}, a YourSide mortgage adviser in Wellington. Free, no-obligation home loan advice.`}
>
  <section class="profile-hero dark">
    <div class="wrap hero-grid">
      {adviser.photo
        ? <img class="avatar" src={adviser.photo} alt={`Photo of ${adviser.name}`} width="220" height="220" />
        : <span class="avatar initial" aria-hidden="true">{adviser.name[0]}</span>}
      <div>
        <span class="eyebrow">Meet the team</span>
        <h1>{adviser.name}</h1>
        <p class="role">{adviser.role}</p>
        <ul class="tags">{adviser.specialties.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div>
        <h2>About {adviser.name}</h2>
        {adviser.bio.map((p) => <p>{p}</p>)}

        {(adviser.phone || adviser.email) && (
          <div class="direct card">
            <h3>Contact {adviser.name} directly</h3>
            {adviser.phone && <p><strong>Phone:</strong> <a href={`tel:${adviser.phone.replace(/\s/g, '')}`}>{adviser.phone}</a></p>}
            {adviser.email && <p><strong>Email:</strong> <a href={`mailto:${adviser.email}`}>{adviser.email}</a></p>}
          </div>
        )}

        <p class="others">
          Also on the team:{' '}
          {others.map((a, i) => <>{i > 0 && ', '}<a href={`/team/${a.slug}/`}>{a.name}</a></>)}
        </p>
      </div>

      <ContactForm adviser={adviser.slug} source={`Adviser page: ${adviser.name}`} heading={`Talk to ${adviser.name}`} />
    </div>
  </section>
</Base>

<style>
  .profile-hero { padding-block: clamp(3rem, 7vw, 4.5rem); background: var(--purple) url('/brand/pattern-2.jpg') center / cover; }
  .hero-grid { display: flex; align-items: center; gap: 2.5rem; flex-wrap: wrap; }
  .avatar { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid var(--ultraviolet); }
  .initial { display: grid; place-items: center; background: var(--ultraviolet); color: #fff; font: 600 4.5rem/1 var(--font-title); }
  h1 { margin-bottom: 0.1em; }
  .role { font-size: 1.2rem; font-weight: 500; opacity: 0.9; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags li { background: rgb(255 255 255 / 12%); font-size: 0.85rem; font-weight: 600; padding: 0.35rem 0.8rem; border-radius: 999px; }

  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .direct { margin: 1.5rem 0; }
  .others { margin-top: 2rem; color: var(--slate-muted); }
</style>
