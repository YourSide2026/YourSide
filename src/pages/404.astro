---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found">
  <PageHero eyebrow="404" title="We couldn’t find that page." intro="It may have moved. Let’s get you back on track.">
    <p class="back"><a href="/" class="btn btn--light">Back to home</a></p>
  </PageHero>
</Base>

<style>
  .back { margin-top: 2rem; }
</style>
