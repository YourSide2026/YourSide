---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { calculator } from '../data/calculator';
---

<Base
  title="Borrowing calculator"
  description="How much could you borrow? Use the YourSide borrowing calculator to estimate your borrowing power, deposit and repayments, then talk to a Wellington mortgage adviser."
>
  <PageHero
    eyebrow="Borrowing calculator"
    title="How much could you borrow?"
    intro="Answer four quick questions for a rough idea of your borrowing power, deposit and repayments. Then talk to an adviser for the real numbers."
  />

  <section class="section">
    <div class="wrap calc" data-config={JSON.stringify(calculator)}>
      <form class="card inputs" id="calc" novalidate>
        <fieldset class="field">
          <legend>My goal is to:</legend>
          <div class="goals">
            <label><input type="radio" name="goal" value="first" checked /> <span>Buy my first home</span></label>
            <label><input type="radio" name="goal" value="next" /> <span>Buy my next home</span></label>
            <label><input type="radio" name="goal" value="investment" /> <span>Buy an investment property</span></label>
            <label><input type="radio" name="goal" value="refinance" /> <span>Refinance a property</span></label>
          </div>
        </fieldset>

        <div class="field">
          <label for="price" data-label-price>What’s your target house price?</label>
          <div class="money"><span>$</span><input id="price" type="text" inputmode="numeric" value="750,000" /></div>
        </div>

        <div class="field">
          <label for="deposit" data-label-deposit>How much deposit do you have?</label>
          <div class="money"><span>$</span><input id="deposit" type="text" inputmode="numeric" value="150,000" /></div>
          <span class="hint" data-hint-deposit>Include savings, KiwiSaver you can withdraw and any gifted money.</span>
        </div>

        <div class="field">
          <label for="income">What’s your annual income before tax?</label>
          <div class="money"><span>$</span><input id="income" type="text" inputmode="numeric" value="140,000" /></div>
          <span class="hint">Add everyone who’ll be on the loan together.</span>
        </div>

        <details class="advanced">
          <summary>Change the example interest rate</summary>
          <div class="field">
            <label for="rate">Interest rate for repayments (%)</label>
            <input id="rate" type="number" step="0.01" min="0" max="20" value={(calculator.exampleRate * 100).toFixed(2)} />
          </div>
        </details>
      </form>

      <div class="results dark" aria-live="polite">
        <span class="eyebrow">Your estimate</span>
        <p class="label">You could borrow up to around</p>
        <p class="big" data-out="borrow">$0</p>

        <dl>
          <div><dt data-label-loan>Loan you’d need</dt><dd data-out="loan">$0</dd></div>
          <div><dt data-label-depositpct>Your deposit</dt><dd data-out="depositPct">0%</dd></div>
          <div><dt>Monthly repayments</dt><dd data-out="monthly">$0</dd></div>
          <div><dt>Fortnightly repayments</dt><dd data-out="fortnightly">$0</dd></div>
        </dl>

        <p class="verdict" data-out="verdict"></p>
        <a href="#calc-contact" class="btn btn--light">Talk to an adviser about this</a>
      </div>
    </div>

    <div class="wrap">
      <p class="small">
        This calculator gives a rough guide only and isn’t a loan offer or financial advice. It assumes a
        {calculator.loanTermYears}-year loan, debt-to-income limits of {calculator.dti.ownerOccupier}× income
        ({calculator.dti.investor}× for investment property), and that you could afford repayments at a
        {(calculator.testRate * 100).toFixed(1)}% test rate. It doesn’t include living costs, other debts,
        dependants or credit card limits, which all affect what a lender will offer. Talk to an adviser for advice that fits your situation.
      </p>
    </div>
  </section>

  <section id="calc-contact" class="section section--tint">
    <div class="wrap contact">
      <div>
        <span class="eyebrow">Next step</span>
        <h2>Let’s turn this into a plan.</h2>
        <p class="intro">An adviser can look at your full situation and give you real numbers from real lenders.</p>
        <p>We’ll include your calculator results with your enquiry, so you won’t need to repeat yourself.</p>
      </div>
      <ContactForm source="Borrowing calculator" id="calc-form" />
    </div>
  </section>
</Base>

<script>
  type Config = {
    dti: { ownerOccupier: number; investor: number };
    minDeposit: { ownerOccupier: number; investor: number };
    testRate: number;
    maxRepaymentShare: number;
    exampleRate: number;
    loanTermYears: number;
  };

  const root = document.querySelector<HTMLElement>('[data-config]')!;
  const cfg: Config = JSON.parse(root.dataset.config!);
  const form = document.querySelector<HTMLFormElement>('#calc')!;
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const nzd = new Intl.NumberFormat('en-NZ', { style: 'currency', currency: 'NZD', maximumFractionDigits: 0 });
  const parse = (v: string) => Number(v.replace(/[^0-9.]/g, '')) || 0;

  // Monthly repayment on a principal-and-interest loan
  const repayment = (loan: number, annualRate: number, years: number) => {
    const n = years * 12;
    const r = annualRate / 12;
    return r === 0 ? loan / n : (loan * r) / (1 - Math.pow(1 + r, -n));
  };
  // Largest loan a monthly repayment can support
  const maxLoanFor = (monthly: number, annualRate: number, years: number) => {
    const n = years * 12;
    const r = annualRate / 12;
    return r === 0 ? monthly * n : (monthly * (1 - Math.pow(1 + r, -n))) / r;
  };

  const labels = {
    buy: { price: 'What’s your target house price?', deposit: 'How much deposit do you have?', loan: 'Loan you’d need', pct: 'Your deposit', hint: 'Include savings, KiwiSaver you can withdraw and any gifted money.' },
    refinance: { price: 'What’s your property worth?', deposit: 'How much is left on your mortgage?', loan: 'Loan to refinance', pct: 'Your equity', hint: 'Your current loan balance, roughly.' },
  };

  // Format money inputs with commas as people type
  form.querySelectorAll<HTMLInputElement>('.money input').forEach((input) => {
    input.addEventListener('input', () => {
      const n = parse(input.value);
      input.value = n ? n.toLocaleString('en-NZ') : '';
    });
  });

  function update() {
    const goal = (form.querySelector<HTMLInputElement>('input[name="goal"]:checked')?.value ?? 'first') as string;
    const isRefi = goal === 'refinance';
    const isInvestor = goal === 'investment';
    const l = isRefi ? labels.refinance : labels.buy;

    $('[data-label-price]').textContent = l.price;
    $('[data-label-deposit]').textContent = l.deposit;
    $('[data-label-loan]').textContent = l.loan;
    $('[data-label-depositpct]').textContent = l.pct;
    $('[data-hint-deposit]').textContent = l.hint;

    const price = parse($<HTMLInputElement>('#price').value);
    const second = parse($<HTMLInputElement>('#deposit').value); // deposit, or loan balance when refinancing
    const income = parse($<HTMLInputElement>('#income').value);
    const rate = (Number($<HTMLInputElement>('#rate').value) || 0) / 100;

    const loan = Math.max(0, isRefi ? second : price - second);
    const equity = isRefi ? price - second : second;
    const depositPct = price > 0 ? equity / price : 0;

    const dtiLimit = income * (isInvestor ? cfg.dti.investor : cfg.dti.ownerOccupier);
    const serviceLimit = maxLoanFor((income / 12) * cfg.maxRepaymentShare, cfg.testRate, cfg.loanTermYears);
    const borrow = Math.max(0, Math.min(dtiLimit, serviceLimit));

    const monthly = repayment(loan, rate, cfg.loanTermYears);
    const fortnightly = (monthly * 12) / 26;
    const minDep = isInvestor ? cfg.minDeposit.investor : cfg.minDeposit.ownerOccupier;

    const roundTo = (n: number, step: number) => Math.round(n / step) * step;
    $('[data-out="borrow"]').textContent = nzd.format(roundTo(borrow, 5000));
    $('[data-out="loan"]').textContent = nzd.format(loan);
    $('[data-out="depositPct"]').textContent = `${Math.round(depositPct * 100)}%`;
    $('[data-out="monthly"]').textContent = nzd.format(monthly);
    $('[data-out="fortnightly"]').textContent = nzd.format(fortnightly);

    let verdict: string;
    if (!price || !income) {
      verdict = 'Fill in the numbers above to see your estimate.';
    } else if (loan > borrow) {
      verdict = `The loan you’d need is more than this rough estimate. Don’t throw in the towel. Different lenders assess things differently, and an adviser can look at your options.`;
    } else if (depositPct < minDep) {
      verdict = isRefi
        ? `You have less than ${minDep * 100}% equity, so some lenders may be more cautious. We know which ones are more flexible.`
        : `Most lenders look for a ${minDep * 100}% deposit${isInvestor ? ' on investment property' : ''}. Lower-deposit options can still be available, so let’s talk.`;
    } else {
      verdict = 'Looks like this could be within reach. An adviser can confirm it and find the right lender for you.';
    }
    $('[data-out="verdict"]').textContent = verdict;

    // Pass a summary to the enquiry form so the adviser sees the numbers
    const goalNames: Record<string, string> = { first: 'First home', next: 'Next home', investment: 'Investment property', refinance: 'Refinance' };
    const summary = `Goal: ${goalNames[goal]} | ${isRefi ? 'Property value' : 'Price'}: ${nzd.format(price)} | ${isRefi ? 'Loan balance' : 'Deposit'}: ${nzd.format(second)} | Income: ${nzd.format(income)} | Estimate: ${nzd.format(roundTo(borrow, 5000))}`;
    document.querySelectorAll<HTMLInputElement>('[data-calc-summary]').forEach((el) => (el.value = summary));
  }

  form.addEventListener('input', update);
  form.addEventListener('change', update);
  update();
</script>

<style>
  .calc { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 860px) { .calc { grid-template-columns: 1fr; } }

  fieldset { border: 0; padding: 0; margin: 0 0 1.25rem; }
  legend { margin-bottom: 0.6rem; }
  .goals { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  @media (max-width: 480px) { .goals { grid-template-columns: 1fr; } }
  .goals label { position: relative; cursor: pointer; }
  .goals input { position: absolute; opacity: 0; }
  .goals span {
    display: block; padding: 0.85rem 1rem; border-radius: var(--radius-sm);
    border: 1.5px solid #cfc4de; font-weight: 600; font-size: 0.95rem; color: var(--purple);
    transition: all 0.15s;
  }
  .goals input:checked + span { background: var(--ultraviolet); border-color: var(--ultraviolet); color: #fff; }
  .goals input:focus-visible + span { outline: 3px solid var(--ultraviolet); outline-offset: 2px; }

  .money { position: relative; }
  .money span { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: var(--slate-muted); font-weight: 600; }
  .money input { padding-left: 1.8rem; font-size: 1.1rem; font-weight: 600; }

  .advanced summary { cursor: pointer; color: var(--ultraviolet); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.75rem; }

  .results {
    position: sticky; top: 96px;
    border-radius: var(--radius); padding: 2rem;
    background: var(--purple) url('/brand/pattern-2.jpg') center / cover;
  }
  .label { margin: 0; opacity: 0.9; }
  .big { font: 600 clamp(2.4rem, 5vw, 3.2rem)/1.1 var(--font-title); letter-spacing: -0.02em; margin: 0.25rem 0 1.5rem; color: #fff; }
  dl { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0 0 1.5rem; padding: 1.25rem 0; border-block: 1px solid rgb(255 255 255 / 18%); }
  dt { font-size: 0.85rem; opacity: 0.85; }
  dd { margin: 0; font-weight: 600; font-size: 1.2rem; }
  .verdict { background: rgb(255 255 255 / 10%); border-radius: var(--radius-sm); padding: 1rem; font-size: 0.95rem; }

  .small { font-size: 0.85rem; color: var(--slate-muted); max-width: 820px; margin-top: 2rem; }

  .contact { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } .results { position: static; } }
</style>
