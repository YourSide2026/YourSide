---
// Dark purple page header with the brand line pattern.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero dark">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 5rem);
    background:
      linear-gradient(120deg, rgb(42 22 69 / 92%) 0%, rgb(58 31 94 / 78%) 60%, rgb(74 40 120 / 70%) 100%),
      var(--purple) url('/brand/pattern-2.jpg') center / cover;
  }
  h1 { max-width: 820px; }
  .lede { max-width: 640px; font-size: 1.15rem; line-height: 1.6; color: rgb(255 255 255 / 82%); margin: 0; }
</style>
