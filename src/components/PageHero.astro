---
// Page header for inner pages: warm paper background, large type, a hairline rule.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  h1 { max-width: 16ch; }
  .lede { max-width: 40rem; font-size: 1.2rem; line-height: 1.6; color: var(--slate-muted); margin: 0; }
</style>
