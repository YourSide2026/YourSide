---
// Newsletter sign-up. Uses Netlify Forms (form name "newsletter"); every copy must keep the same fields.
interface Props {
  id: string;
  source: string;
  variant?: 'card' | 'band';
}
const { id, source, variant = 'card' } = Astro.props;
---

<div class:list={['newsletter', variant]}>
  <div class="copy">
    <span class="eyebrow">Newsletter</span>
    <p class="heading">Mortgage news, without the noise.</p>
    <p class="text">Rate updates, market news and practical tips from our Wellington advisers. Once a month, no spam.</p>
  </div>
  <form
    name="newsletter"
    method="POST"
    action="/subscribed/"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="newsletter" />
    <input type="hidden" name="source" value={source} />
    <p class="visually-hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <div class="row">
      <label class="visually-hidden" for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} type="email" name="email" placeholder="Your email address" autocomplete="email" required />
      <button class="btn" type="submit">Subscribe</button>
    </div>
    <p class="fine">By subscribing you agree to our <a href="/privacy/">privacy policy</a>. Unsubscribe any time.</p>
  </form>
</div>

<style>
  .newsletter { border-radius: var(--radius); }
  .eyebrow { margin-bottom: 0.5rem; }
  .heading { font: 600 1.25rem/1.25 var(--font-title); letter-spacing: -0.01em; color: var(--purple); margin: 0 0 0.5rem; }
  .text { font-size: 0.95rem; color: var(--slate-muted); }
  .fine { font-size: 0.8rem; color: var(--slate-muted); margin: 0.6rem 0 0; }
  .row { display: grid; gap: 0.5rem; }

  /* Sidebar card */
  .card { background: var(--surface); border: 1px solid var(--line); padding: 1.5rem; }

  /* Full-width band */
  .band {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center;
    background: var(--purple); color: #fff; padding: clamp(1.75rem, 4vw, 2.75rem);
  }
  .band .eyebrow { color: var(--uv-light); }
  .band .heading { color: #fff; font-size: clamp(1.4rem, 2.6vw, 1.9rem); }
  .band .text, .band .fine { color: rgb(255 255 255 / 78%); }
  .band .fine a { color: #fff; }
  .band .text { margin: 0; }
  .band .row { grid-template-columns: 1fr auto; }
  .band input { border-color: transparent; }
  .band .btn { background: var(--ultraviolet); }
  .band .btn:hover { background: #fff; color: var(--purple); border-color: #fff; }
  @media (max-width: 760px) { .band { grid-template-columns: 1fr; } .band .row { grid-template-columns: 1fr; } }
</style>
