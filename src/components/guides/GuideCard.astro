---
import { Image } from 'astro:assets';
import { getCategory } from '../../data/categories';
import { type Guide, guideUrl, topicsOf, readingTime, formatDate } from '../../lib/guides';

interface Props {
  guide: Guide;
  headingLevel?: 'h2' | 'h3';
}
const { guide, headingLevel = 'h3' } = Astro.props;
const { data } = guide;
const H = headingLevel;
const topic = getCategory(data.category);
// Words used by the search box: title, summary, topics and the article text itself
const searchText = [
  data.title,
  data.description,
  ...topicsOf(guide).map((t) => getCategory(t).name),
  (guide.body ?? '').replace(/[#*_`>|\[\]()-]+/g, ' ').replace(/\(\/[^)]*\)/g, ' '),
].join(' ').replace(/\s+/g, ' ').toLowerCase();
---

<article
  class="guide-card"
  data-guide
  data-topics={topicsOf(guide).join(' ')}
  data-search={searchText}
>
  <a class="media" href={guideUrl(guide)} tabindex="-1" aria-hidden="true">
    <Image src={data.heroImage} alt="" widths={[400, 720]} sizes="(max-width: 700px) 100vw, 380px" />
  </a>
  <div class="body">
    <span class="topic">{topic.name}</span>
    <H class="title"><a href={guideUrl(guide)}>{data.title}</a></H>
    <p class="excerpt">{data.description}</p>
    <p class="meta">
      <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
      <span aria-hidden="true">·</span>
      {readingTime(guide.body)} min read
    </p>
  </div>
</article>

<style>
  .guide-card {
    position: relative; display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    transition: border-color 0.15s;
  }
  .guide-card:hover { border-color: var(--ultraviolet); }
  .media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--purple); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem 1.4rem 1.4rem; }
  .topic { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ultraviolet); margin-bottom: 0.6rem; }
  .title { font-size: 1.15rem; line-height: 1.3; margin: 0 0 0.6rem; }
  .title a { color: var(--purple); text-decoration: none; }
  /* Make the whole card clickable */
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .guide-card:has(.title a:focus-visible) { outline: 3px solid var(--ultraviolet); outline-offset: 2px; }
  .excerpt {
    font-size: 0.95rem; color: var(--slate-muted); margin: 0 0 1rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .meta { margin: auto 0 0; font-size: 0.85rem; color: var(--slate-muted); display: flex; gap: 0.4rem; }
</style>
