---
// Page layout shared by every calculator: header, inputs + results, the lead panel
// right under the results, notes, optional FAQs and links to the other calculators.
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import CalcLead from './CalcLead.astro';
import MoreTools from './MoreTools.astro';
import { site } from '../../data/site';
import '../../styles/calculator.css';

interface Props {
  slug: string;
  metaTitle: string;
  description: string;
  eyebrow: string;
  title: string;
  intro: string;
  source: string;
  leadTitle?: string;
  leadText?: string;
  button?: string;
  faqs?: { q: string; a: string }[];
}
const { slug, metaTitle, description, eyebrow, title, intro, source, leadTitle, leadText, button, faqs = [] } = Astro.props;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: metaTitle,
    description,
    url: new URL(`/calculators/${slug}/`, site.url).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'NZD' },
    provider: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: new URL('/calculators/', site.url).href },
      { '@type': 'ListItem', position: 3, name: metaTitle },
    ],
  },
];
---

<Base title={metaTitle} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <PageHero eyebrow={eyebrow} title={title} intro={intro}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/calculators/">Calculators</a></nav>
  </PageHero>

  <section class="section">
    <div class="wrap calc">
      <slot name="inputs" />
      <slot name="results" />
    </div>
    <div class="wrap lead-wrap">
      <CalcLead source={source} title={leadTitle} text={leadText} button={button} />
    </div>
    <div class="wrap">
      <p class="calc-note"><slot name="note" /></p>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section faq-section">
      <div class="wrap faq">
        <div>
          <span class="eyebrow">Questions</span>
          <h2>Good to know</h2>
        </div>
        <div>
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <MoreTools current={slug} />
</Base>

<style>
  .crumbs { margin-top: 1.5rem; font-size: 0.85rem; color: rgb(255 255 255 / 70%); }
  .crumbs a { color: rgb(255 255 255 / 85%) !important; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .faq-section { padding-top: 0; }
  .faq { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; border-top: 1px solid var(--line); padding-top: clamp(2.5rem, 6vw, 4rem); }
  .faq details { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .faq summary { cursor: pointer; font-weight: 600; color: var(--purple); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--ultraviolet); font-size: 1.3rem; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 0.75rem 0 0; color: var(--slate-muted); }
  @media (max-width: 760px) { .faq { grid-template-columns: 1fr; } }
</style>
