---
import { tools, toolUrl } from '../../data/tools';
interface Props { current?: string }
const { current } = Astro.props;
const others = tools.filter((t) => t.slug !== current);
---

<section class="section section--tint">
  <div class="wrap">
    <div class="head">
      <h2>More calculators</h2>
      <a class="text-link" href="/calculators/">All calculators</a>
    </div>
    <p class="carry">Numbers you’ve entered carry across, so you won’t need to type them again.</p>
    <div class="tools">
      {others.map((t) => (
        <a class="tool" href={toolUrl(t.slug)}>
          <span class="name">{t.title}</span>
          <span class="blurb">{t.blurb}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; }
  .head h2 { margin: 0; }
  .carry { color: var(--slate-muted); margin: 0.75rem 0 1.75rem; }
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .tool {
    display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem; text-decoration: none;
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 0.2s;
  }
  .tool:hover { background: #fff; }
  .name { font: 500 1.2rem/1.2 var(--font-title); letter-spacing: -0.02em; color: var(--purple); }
  .tool:hover .name { color: var(--ultraviolet); }
  .blurb { font-size: 0.9rem; color: var(--slate-muted); }
</style>
