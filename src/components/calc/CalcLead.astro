---
// Sits directly under a calculator's results: a message that reacts to the result,
// a short enquiry form, and an email-only option for people not ready to talk.
import QuickEnquiry from './QuickEnquiry.astro';
import { advisers } from '../../data/advisers';

interface Props {
  source: string;
  title?: string;
  text?: string;
  button?: string;
}
const {
  source,
  title = 'Want an adviser to check your numbers?',
  text = 'Every lender assesses things a little differently. We’ll look at your full situation and tell you what’s really possible.',
  button = 'Get my numbers checked',
} = Astro.props;
const key = source.toLowerCase().replace(/[^a-z]+/g, '-');
---

<section class="lead" id="check-my-numbers" aria-labelledby="lead-title">
  <div class="lead-copy" data-nudge>
    <h2 id="lead-title" data-nudge-title>{title}</h2>
    <p data-nudge-text>{text}</p>

    <div class="team" aria-label="Our advisers">
      <span class="faces" aria-hidden="true">
        {advisers.map((a) => a.photo ? <img src={a.photo} alt="" width="40" height="40" /> : <span>{a.name[0]}</span>)}
      </span>
      <span>{advisers.map((a) => a.name).join(', ').replace(/, ([^,]*)$/, ' & $1')}, Wellington mortgage advisers</span>
    </div>

    <p class="small-print">Your results are sent with your enquiry, so you won’t need to repeat yourself. We usually reply within one working day, and there’s no credit check.</p>
  </div>

  <div class="lead-form">
    <QuickEnquiry id={`qe-${key}`} source={source} button={button} />

    <details class="email-only">
      <summary>Not ready to talk? Email me my results instead</summary>
      <form
        name="email-results"
        method="POST"
        action="/results-sent/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-email-results
      >
        <input type="hidden" name="form-name" value="email-results" />
        <input type="hidden" name="source" value={source} />
        <input type="hidden" name="calculator_summary" value="" data-calc-summary />
        <p class="visually-hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="email-row">
          <label class="visually-hidden" for={`er-${key}-email`}>Email address</label>
          <input id={`er-${key}-email`} type="email" name="email" placeholder="Your email address" autocomplete="email" required />
          <button class="btn btn--ghost" type="submit">Send</button>
        </div>
        <label class="checkbox small">
          <input type="checkbox" name="newsletter" value="yes" />
          <span>Also send me the monthly YourSide newsletter</span>
        </label>
      </form>
    </details>
  </div>
</section>

<script>
  import { track } from '../../scripts/calc';
  document.querySelectorAll<HTMLFormElement>('[data-email-results]').forEach((f) =>
    f.addEventListener('submit', () => track('lead_submitted', { form: 'email-results' })),
  );
</script>

<style>
  .lead {
    display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start;
    background: var(--paper); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 3rem);
  }
  .lead h2 { font-size: clamp(1.45rem, 2.6vw, 1.9rem); }
  .lead-copy p { color: var(--slate-muted); }
  .team { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0 1.25rem; font-size: 0.9rem; color: var(--slate-muted); }
  .faces { display: flex; flex: none; }
  .faces > * {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: var(--purple); color: #fff; font-weight: 600; font-size: 0.9rem; border: 2px solid #fff; object-fit: cover;
  }
  .faces > * + * { margin-left: -10px; }
  .faces > *:nth-child(2) { background: var(--ultraviolet); }
  .faces > *:nth-child(3) { background: #5b2d91; }
  .faces > *:nth-child(4) { background: var(--slate); }
  .small-print { font-size: 0.92rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .lead-form { background: #fff; border-radius: var(--radius-sm); padding: clamp(1.25rem, 3vw, 2rem); }
  .email-only { margin-top: 1.25rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .email-only summary { cursor: pointer; font-weight: 500; color: var(--purple); font-size: 0.95rem; text-decoration: underline; text-decoration-color: var(--ultraviolet); text-underline-offset: 4px; }
  .email-only form { margin-top: 0.9rem; }
  .email-row { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; }
  .small { font-size: 0.85rem; margin-top: 0.6rem; }
  @media (max-width: 860px) { .lead { grid-template-columns: 1fr; } }
</style>
