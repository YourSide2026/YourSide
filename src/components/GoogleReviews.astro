---
// Google rating, pasted-in reviews and a "leave a review" button for one adviser.
// Content lives in src/data/reviews.ts.
import { profiles, reviews } from '../data/reviews';

interface Props {
  adviser: string; // adviser slug
  name: string; // adviser first name, for headings
}
const { adviser, name } = Astro.props;
const profile = profiles.find((p) => p.advisers.includes(adviser));
const list = profile ? reviews.filter((r) => r.profile === profile.id && r.advisers.includes(adviser)) : [];
const stars = (n: number) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n));
const G = 'M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 01-2 3.1v2.6h3.3c1.9-1.8 3-4.4 3-7.5z';
---

{profile && (
  <section class="section section--tint reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="summary">
        <div>
          <h2 id="reviews-title">What clients say about {profile.name}</h2>
        </div>
        <div class="score">
          <svg class="g" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
            <path d={G} fill="#4285F4" />
            <path d="M12 22c2.7 0 5-.9 6.7-2.5l-3.3-2.6c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3v2.6A10 10 0 0012 22z" fill="#34A853" />
            <path d="M6.4 13.8a6 6 0 010-3.8V7.4H3a10 10 0 000 9z" fill="#FBBC05" />
            <path d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 003 7.4L6.4 10C7.2 7.8 9.4 6 12 6z" fill="#EA4335" />
          </svg>
          <div>
            <p class="rating"><strong>{profile.rating.toFixed(1)}</strong> <span class="stars" aria-hidden="true">{stars(profile.rating)}</span></p>
            <p class="count">{profile.rating.toFixed(1)} out of 5 from {profile.count} Google reviews</p>
          </div>
        </div>
      </div>

      {list.length > 0 && (
        <ul class="cards">
          {list.map((r) => (
            <li class="review">
              <p class="stars" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</p>
              <blockquote><p>{r.text}</p></blockquote>
              <p class="who"><strong>{r.name}</strong>{r.when && <span> · {r.when}</span>}<span class="src"> · Google review</span></p>
            </li>
          ))}
        </ul>
      )}

      <div class="actions">
        <a class="btn btn--ghost" href={profile.url} target="_blank" rel="noopener">Read all {profile.count} reviews on Google</a>
        <a class="btn" href={profile.reviewUrl} target="_blank" rel="noopener">Worked with {name}? Leave a review</a>
      </div>
    </div>
  </section>
)}

<style>
  .summary { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .summary h2 { margin: 0; }
  .score { display: flex; align-items: center; gap: 1rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.4rem; }
  .score p { margin: 0; }
  .rating { display: flex; align-items: center; gap: 0.6rem; }
  .rating strong { font: 600 2rem/1 var(--font-title); color: var(--purple); }
  .stars { color: #f5b301; letter-spacing: 0.1em; font-size: 1.1rem; margin: 0; }
  .count { font-size: 0.88rem; color: var(--slate-muted); }

  .cards { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .review { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  blockquote { margin: 0.6rem 0 1rem; color: var(--slate); }
  blockquote p { margin: 0; }
  .who { margin: auto 0 0; font-size: 0.9rem; color: var(--slate-muted); }
  .who strong { color: var(--purple); }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
