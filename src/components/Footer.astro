---
import { site } from '../data/site';
import Logo from './Logo.astro';
import { services } from '../data/services';
import { advisers } from '../data/advisers';
const { minimal = false } = Astro.props as { minimal?: boolean };
const year = new Date().getFullYear();
// Footer icons: only the ones with a link set in src/data/site.ts are shown
const icons = [
  { label: 'Facebook', href: site.social.facebook, path: 'M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9H17l.5-4h-4v-2.2c0-.5.4-.8.9-.8z' },
  { label: 'Instagram', href: site.social.instagram, path: 'M12 7.3a4.7 4.7 0 100 9.4 4.7 4.7 0 000-9.4zm0 7.7a3 3 0 110-6 3 3 0 010 6zm6-7.9a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0zM12 4.6c2.4 0 2.7 0 3.6.1 2.4.1 3.6 1.3 3.7 3.7v7.2c-.1 2.4-1.3 3.6-3.7 3.7H8.4c-2.4-.1-3.6-1.3-3.7-3.7V8.4c.1-2.4 1.3-3.6 3.7-3.7.9-.1 1.2-.1 3.6-.1zM12 3c-2.4 0-2.7 0-3.7.1C5 3.2 3.2 5 3.1 8.3 3 9.3 3 9.6 3 12s0 2.7.1 3.7c.1 3.3 1.9 5.1 5.2 5.2 1 .1 1.3.1 3.7.1s2.7 0 3.7-.1c3.3-.1 5.1-1.9 5.2-5.2.1-1 .1-1.3.1-3.7s0-2.7-.1-3.7C20.8 5 19 3.2 15.7 3.1 14.7 3 14.4 3 12 3z' },
  { label: 'LinkedIn', href: site.social.linkedin, path: 'M5 9h3.5v12H5zM6.8 3.5a2 2 0 110 4 2 2 0 010-4zM10.5 9H14v1.7c.5-1 1.8-2 3.7-2 3.8 0 4.3 2.4 4.3 5.6V21h-3.5v-5.9c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1v6h-3.7z' },
  { label: 'Email', href: site.email ? `mailto:${site.email}` : null, path: 'M3 5h18v14H3zm1.8 1.8v.4l7.2 5.3 7.2-5.3v-.4zm14.4 2.6l-7.2 5.2-7.2-5.2v7.8h14.4z' },
].filter((i) => i.href) as { label: string; href: string; path: string }[];
---

<footer class:list={['site-footer dark', { 'site-footer--minimal': minimal }]}>
  {!minimal && (
  <div class="wrap cols">
    <div class="brand">
      <a href="/" class="footer-logo" aria-label="YourSide home"><Logo variant="white" height={28} /></a>
      <p class="tag">{site.tagline}</p>
      <p>{site.location}</p>
      {site.phone && <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>}
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      {icons.length > 0 && (
        <ul class="icons" aria-label="Follow or contact YourSide">
          {icons.map((i) => (
            <li>
              <a href={i.href} aria-label={i.label === 'Email' ? 'Email us' : `YourSide on ${i.label}`} title={i.label === 'Email' ? 'Email us' : i.label} {...(i.label !== 'Email' && { target: '_blank', rel: 'noopener' })}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={i.path} fill="currentColor" /></svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <h2>Home loans</h2>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Resources</h2>
      <ul>
        <li><a href="/calculators/">Mortgage calculators</a></li>
        <li><a href="/interest-rates/">Interest rates</a></li>
        <li><a href="/guides/">Guides &amp; insights</a></li>
        <li><a href="/contact/">Contact us</a></li>
      </ul>
    </div>

    <div>
      <h2>Our team</h2>
      <ul>
        {advisers.map((a) => <li><a href={`/team/${a.slug}/`}>{a.name}</a></li>)}
      </ul>
    </div>
  </div>
  )}

  <div class="wrap legal">
    <p>© {year} {site.name}{site.fspNumber && ` · FSP${site.fspNumber}`}</p>
    <p>
      <a href="/disclosure/">Disclosure information</a>
      <a href="/privacy/">Privacy policy</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { padding-block: 4rem 2rem; font-size: 0.95rem; }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 1.4fr repeat(3, 1fr); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
  .footer-logo { display: inline-flex; margin-bottom: 1.25rem; }
  .tag { font-weight: 600; color: var(--uv-light); }
  h2 {
    font-family: var(--font-body); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--uv-light) !important;
    margin-bottom: 1rem;
  }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  a { color: #fff !important; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .icons { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; gap: 0.6rem; }
  .icons a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    background: rgb(255 255 255 / 10%); border: 1px solid rgb(255 255 255 / 18%); transition: background 0.15s, border-color 0.15s;
  }
  .icons a:hover { background: var(--ultraviolet); border-color: var(--ultraviolet); text-decoration: none; }
  .site-footer--minimal { padding-block: 0.5rem 2rem; }
  .site-footer--minimal .legal { margin-top: 1.5rem; }
  .legal {
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 15%);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: 0.85rem; opacity: 0.85;
  }
  .legal p { margin: 0; }
  .legal a + a { margin-left: 1.25rem; }
</style>
