---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Throwing in the towel? We’ll catch it.',
  text = 'Getting home loans across the line is what we do best. Talk to a YourSide adviser, at no cost to you.',
} = Astro.props;
---

<section class="cta">
  <div class="wrap inner">
    <h2>{title}</h2>
    <div class="side">
      <p>{text}</p>
      <a href="/contact/" class="btn btn--light">Talk to an adviser</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--ultraviolet); color: #fff; padding-block: clamp(3.5rem, 8vw, 5.5rem); }
  .inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: end; }
  h2 { color: #fff; font-size: clamp(2.1rem, 4.4vw, 3.6rem); margin: 0; max-width: 14ch; }
  p { font-size: 1.1rem; color: rgb(255 255 255 / 90%); }
  .cta .btn--light:hover { background: var(--purple); border-color: var(--purple); }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } }
</style>
